{
  "type": "object",
  "description": "The probe schedule this candidate must discharge, and the guard profile to run it under.",
  "additionalProperties": false,
  "required": ["schema_version", "trust_mode", "schedule", "coverage"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "trust_mode": {"type": "string", "enum": ["trusted", "untrusted"]},
    "schedule": {
      "type": "array",
      "description": "One row per distribution case, in suite order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "shape_ids", "seeds", "selection_digest", "expected_probes"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "shape_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "seeds": {"type": "array", "items": {"type": "integer"}},
          "selection_digest": {"type": "string", "minLength": 1},
          "expected_probes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "The depth receipt shown to the independent reviewer.",
      "additionalProperties": false,
      "required": ["mode", "coverage", "total_shapes", "world_size", "planned_rank_probes", "selected_shapes_per_case"],
      "properties": {
        "mode": {"type": "string", "enum": ["light", "thorough"]},
        "coverage": {"type": "string", "enum": ["compact", "exhaustive"]},
        "total_shapes": {"type": "integer", "minimum": 1},
        "world_size": {"type": "integer", "minimum": 1},
        "planned_rank_probes": {"type": "integer", "minimum": 1},
        "selected_shapes_per_case": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
